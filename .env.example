# Cluster-wide variables, shared by every demo under demos/.
# Copy to .env (gitignored) and fill in real values. Never commit .env.
# Demo-specific variables (OPENSHELL_NAMESPACE, etc.) live in each demo's own .env.

OPENSHELL_CHART_VERSION=            # NO "v" prefix — use 0.0.97, not v0.0.97
CLUSTER_APPS_DOMAIN=                # e.g. apps.mycluster.example.com
