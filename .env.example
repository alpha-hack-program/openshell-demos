# Cluster-wide variables, shared by base/ and every demo under demos/.
# Copy to .env (gitignored) and fill in real values. Never commit .env.

OPENSHELL_NAMESPACE=openshell
OPENSHELL_CHART_VERSION=            # NO "v" prefix — use 0.0.97, not v0.0.97
CLUSTER_APPS_DOMAIN=                # e.g. apps.mycluster.example.com
OPENSHELL_ROUTE=false               # set to "true" to use a passthrough Route instead of port-forward (non-official path)
