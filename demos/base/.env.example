# All variables for the base install — cluster-wide and demo-specific.
# Copy to .env alongside this file (gitignored). Real secrets never committed.

OPENSHELL_CHART_VERSION=0.0.106     # NO "v" prefix — this guide is written against 0.0.106
CLUSTER_APPS_DOMAIN=                 # e.g. apps.mycluster.example.com

OPENSHELL_NAMESPACE=openshell-base-demo
OPENSHELL_ROUTE=true                # recommended — exposes the gateway via a passthrough Route (set to "false" for port-forward only)
CERT_MANAGER=false                  # set to "true" to use cert-manager for TLS instead of the PKI init job
