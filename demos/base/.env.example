# Demo-specific variables for the base install.
# Copy to .env alongside this file (gitignored). Real secrets never committed.
# Also source the root .env for cluster-wide variables (OPENSHELL_CHART_VERSION, etc.).

OPENSHELL_NAMESPACE=openshell-base-demo
OPENSHELL_ROUTE=false               # set to "true" to use a passthrough Route instead of port-forward (non-official path)
CERT_MANAGER=false                  # set to "true" to use cert-manager for TLS instead of the PKI init job
