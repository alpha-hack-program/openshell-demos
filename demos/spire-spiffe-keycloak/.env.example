# Demo-specific variables for spire-spiffe-keycloak.
# Copy to .env alongside this file (gitignored). Real secrets never committed.

KEYCLOAK_HOST=                       # e.g. keycloak.apps.<cluster-domain>
KEYCLOAK_REALM=openshell
KEYCLOAK_CLIENT_ID_CLI=openshell-cli
KEYCLOAK_CLIENT_ID_GATEWAY=openshell-gateway
KEYCLOAK_CLIENT_SECRET=              # confidential client secret, never commit a real value
SPIRE_TRUST_DOMAIN=openshell.demo    # Path B only
