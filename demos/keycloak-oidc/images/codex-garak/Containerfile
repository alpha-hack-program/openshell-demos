# Custom sandbox image for red-team evaluations.
# Bakes agent-proxy into a Codex-capable sandbox so Garak can talk
# OpenAI-compatible to the agent running inside the sandbox.
#
# Before building, put a musl static binary in this directory — the native
# `target/release` build is too new (glibc) for this base image:
#   make -C util/agent-proxy image-codex
# (runs `cargo build --release --target x86_64-unknown-linux-musl`, copies
# the binary here, then `podman build`)
#
# Base image: Codex 0.146.0+ (supports wire_api = "responses" with
# namespace tools, required for MCP via the Responses API).
# The image already satisfies OpenShell's sandbox requirements
# (non-root user, /sandbox workspace, iproute2).
FROM quay.io/aipcc/base-images/agentic/codex:0.0.1-1786355012

COPY agent-proxy /usr/local/bin/agent-proxy

USER sandbox
WORKDIR /sandbox
