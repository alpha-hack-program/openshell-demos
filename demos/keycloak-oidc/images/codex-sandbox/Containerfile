# OpenShift-compatible rebuild of the upstream Codex sandbox image.
#
# Same fix and rationale as ../claude-sandbox/Containerfile — see that
# file's comment header and docs/openshell-0.1.2-upgrade.md for the full
# root-cause writeup. Confirmed live: identity resolves to 1001:0 in the
# upstream image, OpenShell 0.1.2 on OpenShift runs workspace-init as a
# namespace-derived UID/GID instead, and without this fix seeding fails
# with "Permission denied (os error 13)". With it, the sandbox reaches
# Ready and `codex --version` runs successfully.
#
# Build and push:
#   podman build -t quay.io/atarazana/codex-sandbox:0.4.0 \
#     -t quay.io/atarazana/codex-sandbox:latest \
#     -f demos/keycloak-oidc/images/codex-sandbox/Containerfile \
#     demos/keycloak-oidc/images/codex-sandbox/
#   podman push quay.io/atarazana/codex-sandbox:0.4.0
#   podman push quay.io/atarazana/codex-sandbox:latest
#
# Bump the FROM tag here when a newer upstream codex-sandbox release
# ships, and re-run the build/push above.
FROM quay.io/aipcc/agentic-ci/codex-sandbox:0.4.0

USER root
RUN chmod -R a+rX /sandbox
USER sandbox
