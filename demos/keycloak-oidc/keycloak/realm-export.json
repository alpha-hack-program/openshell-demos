{
  "realm": "openshell",
  "enabled": true,
  "roles": {
    "realm": [
      { "name": "openshell-admin", "description": "Full OpenShell gateway access" },
      { "name": "openshell-user", "description": "Standard OpenShell gateway access" },
      {
        "name": "banker",
        "description": "Baseline role for every Meridian private banker — composite over the four banking data-service roles",
        "composite": true,
        "composites": {
          "realm": ["mcp-portfolio-user", "mcp-crm-calendar-user", "mcp-market-news-user"]
        }
      },
      { "name": "compatibility-user", "description": "Extra permission granted via the compatibility-users group — access to the mcp-compatibility server" },
      { "name": "mcp-portfolio-user", "description": "Access to mcp-portfolio (client holdings/performance)" },
      { "name": "mcp-crm-calendar-user", "description": "Access to mcp-crm-calendar (banker meetings)" },
      { "name": "mcp-market-news-user", "description": "Access to mcp-market-news (public market news)" }
    ]
  },
  "groups": [
    {
      "name": "compatibility-users",
      "path": "/compatibility-users",
      "realmRoles": ["compatibility-user"]
    }
  ],
  "clients": [
    {
      "clientId": "openshell-cli",
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://127.0.0.1/*", "http://localhost/*"],
      "webOrigins": ["+"],
      "protocolMappers": [
        {
          "name": "openshell-cli-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "openshell-cli",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "lightweight.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "openshell-gateway",
      "publicClient": false,
      "protocol": "openid-connect",
      "secret": "openshell-gateway-demo-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "openshell-admin",
      "enabled": true,
      "firstName": "OpenShell",
      "lastName": "Admin",
      "email": "openshell-admin@demo.local",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "openshell-admin", "temporary": false }],
      "realmRoles": ["openshell-admin", "offline_access"]
    },
    {
      "username": "alice",
      "enabled": true,
      "firstName": "Alice",
      "lastName": "Meridian",
      "email": "alice@meridian.demo.local",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }],
      "realmRoles": ["openshell-user", "offline_access", "banker"],
      "groups": ["/compatibility-users"]
    },
    {
      "username": "bob",
      "enabled": true,
      "firstName": "Bob",
      "lastName": "Meridian",
      "email": "bob@meridian.demo.local",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }],
      "realmRoles": ["openshell-user", "offline_access", "banker"]
    },
    {
      "username": "charlie",
      "enabled": true,
      "firstName": "Charlie",
      "lastName": "Meridian",
      "email": "charlie@meridian.demo.local",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "charlie", "temporary": false }],
      "realmRoles": ["openshell-user", "offline_access", "banker"]
    }
  ]
}
