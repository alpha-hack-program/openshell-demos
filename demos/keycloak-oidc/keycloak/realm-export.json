{
  "realm": "openshell",
  "enabled": true,
  "roles": {
    "realm": [
      { "name": "openshell-admin", "description": "Full OpenShell gateway access" },
      { "name": "openshell-user", "description": "Standard OpenShell gateway access" },
      { "name": "mcp-server-a-user", "description": "Authorized to be onboarded against mcp-server-a (Path B extension)" },
      { "name": "mcp-server-b-user", "description": "Authorized to be onboarded against mcp-server-b (Path B extension)" }
    ]
  },
  "clients": [
    {
      "clientId": "openshell-cli",
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://127.0.0.1/*", "http://localhost/*"],
      "webOrigins": ["+"],
      "protocolMappers": [
        {
          "name": "openshell-cli-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "openshell-cli",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "lightweight.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "openshell-gateway",
      "publicClient": false,
      "protocol": "openid-connect",
      "secret": "openshell-gateway-demo-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "openshell-admin",
      "enabled": true,
      "firstName": "OpenShell",
      "lastName": "Admin",
      "email": "openshell-admin@demo.local",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "openshell-admin", "temporary": false }],
      "realmRoles": ["openshell-admin", "offline_access"]
    },
    {
      "username": "user1",
      "enabled": true,
      "firstName": "user1",
      "lastName": "Demo",
      "email": "user1@demo.local",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "user1", "temporary": false }],
      "realmRoles": ["openshell-user", "offline_access"]
    },
    {
      "username": "user2",
      "enabled": true,
      "firstName": "user2",
      "lastName": "Demo",
      "email": "user2@demo.local",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "user2", "temporary": false }],
      "realmRoles": ["openshell-user", "offline_access"]
    }
  ]
}
