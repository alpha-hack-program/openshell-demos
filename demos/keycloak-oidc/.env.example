# All variables for keycloak-oidc — cluster-wide and demo-specific.
# Copy to .env alongside this file (gitignored). Real secrets never committed.

OPENSHELL_CHART_VERSION=0.1.2       # NO "v" prefix — this guide is written against 0.1.2
CLUSTER_APPS_DOMAIN=                 # e.g. apps.mycluster.example.com

OPENSHELL_NAMESPACE=keycloak-oidc-demo
CERT_MANAGER=true                    # requires the OpenShift cert-manager Operator — see README's "2a. Helm install"
LETSENCRYPT_CLUSTER_ISSUER=          # e.g. letsencrypt-prod — leave empty for self-signed CA (the default; requires CERT_MANAGER=true), see docs/tls-lets-encrypt.md
KEYCLOAK_HOST=                       # e.g. keycloak.apps.<cluster-domain>
KEYCLOAK_REALM=openshell
KEYCLOAK_CLIENT_ID_CLI=openshell-cli
KEYCLOAK_CLIENT_ID_GATEWAY=openshell-gateway
KEYCLOAK_CLIENT_SECRET=openshell-gateway-demo-secret   # hardcoded in realm-export.json — demo only
SPIRE_TRUST_DOMAIN=openshell.demo    # experimental Path B only

# Agent sandbox base images. These are this repo's rebuilds of the stock
# aipcc images, not the stock images themselves, and on OpenShift that is
# required rather than cosmetic: the upstream images are only world-
# readable for their own build UID, while OpenShift runs the sandbox under
# an arbitrary UID from the namespace's assigned range. OpenShell 0.1.2
# then fails to seed the workspace and the sandbox never reaches Ready.
# The rebuild adds nothing but `chmod -R a+rX /sandbox` — see
# images/claude-sandbox/Containerfile and images/codex-sandbox/Containerfile,
# and docs/openshell-0.1.2-upgrade.md's "Blocking finding" for the
# diagnosis.
CLAUDE_IMAGE=quay.io/atarazana/claude-sandbox:0.4.0
CODEX_IMAGE=quay.io/atarazana/codex-sandbox:0.4.0

# onboarding-web (see docs/self-service-onboarding.md) — self-service
# token-attach web app, Option B. Leave ONBOARDING_WEB_ROUTE_HOST unset to
# use the default onboarding-web-<namespace>.<apps-domain> convention —
# scripts/01-deploy-keycloak.sh (rendering the realm JSON) and
# scripts/11-deploy-onboarding-web.sh (the actual deploy) both derive it
# with that same formula, so it stays in sync automatically. Only set it
# here if you need a non-default hostname, and it must then exactly match
# the redirectUris host registered on the openshell-onboarding-web
# Keycloak client — see keycloak/realm-export.json (raw template) /
# keycloak/realm-export.rendered.json (what actually gets imported). That
# client is public (PKCE required), not confidential — Providers v2's own
# refresh grant has no way to supply a client secret, confirmed live — so
# there's no client secret to set here.
ONBOARDING_WEB_ROUTE_HOST=          # optional override — e.g. onboarding-web-<namespace>.<apps-domain>

# OpenClaw chat frontend (see README.md Annex H) — optional, experimental,
# community-maintained upstream. Leave OPENCLAW_ROUTE_HOST unset to use the
# default openclaw-<namespace>.<apps-domain> convention —
# scripts/01-deploy-keycloak.sh and scripts/13-deploy-openclaw.sh both
# derive it with that same formula. The openshell-openclaw-proxy client
# secret is generated fresh by scripts/01-deploy-keycloak.sh each run
# (never committed) — see that script's printed instructions for the
# Secret to create from it.
OPENCLAW_ROUTE_HOST=                # optional override — e.g. openclaw-<namespace>.<apps-domain>

# RHCL MCP Gateway integration. This is the default access path the main
# README walks through from step 4 onward (gateway-routed MCP access) —
# leave both flags below at their README-default `true` unless you're
# following the direct-access alternative described there. Set
# MCP_GATEWAY_ENABLED=true to have 06-deploy-mcp-servers.sh create
# per-server HTTPRoute + MCPServerRegistration resources, attaching to the
# Gateway/MCPGatewayExtension/GatewayClass the ../mcp-gateway chart creates
# (see the main README's "Installing RHCL" and "4a. Deploy the MCP Gateway"
# steps — install that chart once per cluster before setting this to true).
MCP_GATEWAY_ENABLED=true
MCP_GATEWAY_NAME=mcp-gateway
MCP_GATEWAY_NAMESPACE=openshift-ingress
MCP_GATEWAY_SECTION=mcp
MCP_GATEWAY_REG_NAMESPACE=mcp-gateway-system
MCP_GATEWAY_INTERNAL_DOMAIN=mcp.local
MCP_GATEWAY_PORT=8010
MCP_GATEWAY_PUBLIC_HOST=              # e.g. mcp.apps.<cluster-domain> — must match the ../mcp-gateway chart's gateway.publicHost
# MCP Gateway authentication + authorization (requires the rhcl-operator
# CSV + a Kuadrant CR — see the main README's "Installing RHCL"). Uses the
# RHCL 1.4 two-listener pattern:
#   mcp  listener (with hostname) — authn AuthPolicy validates JWT (401)
#   mcps listener (no hostname)   — authz AuthPolicy checks per-tool/prompt
#     permissions via resource_access.<server>.roles CEL rules (403)
# Both listeners, plus the mcp-gateway-authn-ssl EnvoyFilter, come from the
# ../mcp-gateway chart (04a in the main README) — nothing left to
# separately configure here beyond this flag.
MCP_GATEWAY_AUTH_ENABLED=true

# Set both MCP_GATEWAY_* flags above to false instead for the direct-access
# alternative (each sandbox talks straight to each server's own Envoy
# sidecar) — see the main README's "What the MCP Gateway does" for what
# that skips.

# MCP servers — informational only. `scripts/06-deploy-mcp-servers.sh` does
# NOT read these; the actual deployed images/tags are pinned directly in
# `mcp-servers/values.yaml` (by design — see the comment there about why
# `--set servers[0].image...` isn't used). Editing these values has no
# effect on what gets deployed; keep them in sync with values.yaml manually
# if you change the pinned versions there.
MCP_COMPATIBILITY_IMAGE=quay.io/atarazana/compatibility-engine-mcp-rs           # e.g. ghcr.io/your-org/mcp-compatibility
MCP_COMPATIBILITY_TAG=3.2.0
# mcp-portfolio, mcp-crm-calendar, mcp-market-news are this repo's own
# images (quay.io/atarazana/<name>) — see mcp-servers/values.yaml.
KEYCLOAK_ADMIN_USER=                 # from the keycloak-initial-admin secret (step 1b)
KEYCLOAK_ADMIN_PASSWORD=             # from the keycloak-initial-admin secret (step 1b)
KEYCLOAK_ADMIN_TOKEN=                # short-lived; obtain via your own admin login, never persist

# Required for step 4's mcp-market-news news-generator (an OpenAI-compatible
# /v1/chat/completions call — see mcp/mcp-market-news/src/bin/news_generator.rs
# and mcp-servers/values.yaml's newsGenerator: block, which has no chart-side
# default for any of these three) — not just the optional Codex + BYO LLM
# recipe below (see "Codex + BYO LLM + MCP tool" in README, Annex A) that
# also reads them. If you use both, the same endpoint/model must satisfy
# both use cases: news_generator only needs a plain chat-completions
# endpoint, but the Codex recipe additionally needs OpenAI Responses API +
# namespace tools (currently: OpenAI API, vLLM >= 0.25.0) — support on
# third-party providers is model-dependent, see
# docs/inference-api-compatibility.md.
#
# Prefer the PLATFORM_OPENAI_* block below for the news-generator; these
# remain as the fallback and for the Codex recipe.
OPENAI_API_KEY=
OPENAI_BASE_URL=                     # e.g. https://api.openai.com or your vLLM endpoint
OPENAI_MODEL=

# The news-generator's own credentials. Used in preference to OPENAI_*
# above, falling back to them per-variable when unset, so an existing .env
# keeps working unchanged.
#
# Worth setting on a MaaS cluster, because the generator is a SERVICE, not
# a person: it regenerates a batch every GENERATION_INTERVAL_MINUTES for
# as long as the demo is up, and MaaS bills every call to whoever owns the
# key. Pointed at a banker's key it accrues orders of magnitude more spend
# than any human in the demo -- observed here at ~974k tokens for the
# key's owner against ~6.4k and ~2.1k for two bankers actively running
# scenes -- which swamps the Usage dashboard's per-user panels and makes
# it look as though only one banker is using the system at all. Give it
# its own key (and ideally its own MaaSSubscription) and per-banker
# attribution becomes meaningful again. See dashboards/README.md.
#
# Only a chat-completions endpoint is needed here, unlike CODEX_* which
# must speak the Responses API. Base URL and model are separately
# overridable because a dedicated platform subscription may publish a
# different model than the bankers' one, even on the same MaaS host.
PLATFORM_OPENAI_API_KEY=
PLATFORM_OPENAI_BASE_URL=            # defaults to OPENAI_BASE_URL
PLATFORM_OPENAI_MODEL=               # defaults to OPENAI_MODEL

# Set true when PLATFORM_OPENAI_MODEL is a REASONING model (qwen3, etc).
# Such a model spends part of its token budget on a <think> block before
# any JSON, and nothing in the prompt bounds it: measured on qwen3-8b,
# ~2000 of 4000 tokens went to reasoning, so the JSON array usually fits
# -- but when it doesn't, the response is truncated mid-think and the run
# dies with "could not find a JSON array or object in LLM response:
# <think>". Batch 1 makes ~12 such calls and needs only one to lose, so
# the symptom is an init container that CrashLoops intermittently rather
# than failing cleanly every time. Setting this cut the same call to ~600
# tokens and ~4.6x faster. Harmless to leave false for ordinary models.
NEWS_GENERATION_DISABLE_THINKING=false

# Required for step 5's Claude Code harness (see "Provision the Claude Code
# harness" in README) — this is the main recipe, not optional.
# Endpoint must be Anthropic Messages API compatible.
# Some providers expose this under a separate path (e.g. /anthropic) — check your provider's docs.
# If your endpoint is an in-cluster KServe/vLLM InferenceService, prefer its
# internal ClusterIP Service (plain http://<svc>.<ns>.svc.cluster.local:<port>)
# over an external Route — scripts/15-provision-claude-sandbox.sh parses a
# non-443 port out of this URL and threads it through
# providers/byo-claude-profile.yaml's <llm-port> placeholder. Confirmed live
# (2026-09-16): an external Route goes through the sandbox's forward-proxy
# (TLS-terminating, credential-injecting), which was found broken for ALL
# external HTTPS egress after a Keycloak realm re-import — the internal
# Service bypasses that path entirely, same as cluster-internal MCP calls.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=                  # e.g. https://api.anthropic.com, or http://<svc>.<ns>.svc.cluster.local:<port> for an in-cluster endpoint
ANTHROPIC_MODEL=

# Optional: per-banker LLM keys. scripts/15 and /16 prefer
# ANTHROPIC_API_KEY_<USER> / OPENAI_API_KEY_<USER> (user id uppercased,
# dashes to underscores) and fall back to the shared values above, so a
# single-key setup keeps working unchanged.
#
# Worth setting when the endpoint meters per key — an OpenShift MaaS
# subscription does — because it turns one pooled bill into per-banker
# token accounting. Nothing else has to change: the byo-claude provider is
# already created per workspace, so each banker has always had their own
# credential slot; only the value was shared.
#
# Set the OPENAI_ ones too, not just ANTHROPIC_: session-auditor's
# classification is a second, independent call, and leaving it shared
# would re-pool exactly the usage these separate.
#
# Rotating a key does NOT need re-provisioning — the sandbox holds a
# resolve-placeholder and the proxy substitutes the current value per
# request:
#   openshell provider update byo-claude \
#     --credential "ANTHROPIC_AUTH_TOKEN=<new>" --workspace <user> --wait
ANTHROPIC_API_KEY_ALICE=
ANTHROPIC_API_KEY_BOB=
ANTHROPIC_API_KEY_CHARLIE=
OPENAI_API_KEY_ALICE=
OPENAI_API_KEY_BOB=
OPENAI_API_KEY_CHARLIE=

# Codex LLM endpoint (Annex A's "Codex + BYO LLM" recipe). Deliberately
# separate from OPENAI_* above, because they are usually different
# endpoints: codex-cli rejects `wire_api = "chat"` outright since 0.146
# ("no longer supported", a hard config-load error) and sends MCP tools as
# `"type": "namespace"` tools, so it needs the OpenAI *Responses* API.
# MaaS can serve it, but only via a model published with
# apiFormat: openai-responses -- see maas/README.md for the manifests and
# why the stock deepseek-flash (chat-completions) will not do. The URL
# must end in /v1, or codex-cli posts to /responses and gets
# "BadRequest - unsupported API endpoint". Falls back to OPENAI_* when
# unset; a vendor endpoint such as https://api.deepseek.com/ also works
# directly, at the cost of bypassing MaaS and its per-user accounting.
#
# Per-user keys follow the same CODEX_API_KEY_<USER> convention as the
# other two families.
CODEX_BASE_URL=https://maas.apps.<cluster-domain>/v1
CODEX_MODEL=deepseek-flash-responses
CODEX_API_KEY=
CODEX_API_KEY_ALICE=
CODEX_API_KEY_BOB=
CODEX_API_KEY_CHARLIE=

# Optional: Red-team evaluation images (see docs/evalhub-redteam.md)
GARAK_IMAGE_REGISTRY=quay.io/atarazana  # registry for custom garak sandbox images

# Optional: Scene 7 ("Watching the audit trail live") — session-audited
# sandboxes, see util/session-auditor/README.md and
# scripts/16-provision-audited-sandbox.sh. quay.io/atarazana, same
# registry as every other deployable image in this repo — published via
# `make image-claude image-codex push-claude push-codex` from
# util/session-auditor (a manual/local step, separate from cutting a
# session-auditor-v* release).
#
# Pinned to the exact tags this guide is written against, in the Makefile's
# `<base-image-tag>-<session-auditor-crate-version>` form. Never substitute
# `latest` or a bare base tag: sandbox pods run imagePullPolicy
# IfNotPresent, so a tag that gets rebuilt in place leaves nodes serving
# whatever binary they cached first — and the symptom is not an error but a
# sandbox that runs perfectly while emitting no audit signal at all.
CLAUDE_AUDIT_IMAGE=quay.io/atarazana/claude-audit:0.4.0-0.1.5
CODEX_AUDIT_IMAGE=quay.io/atarazana/codex-audit:0.4.0-0.1.5

# Which API shape session-auditor uses for its own classification call:
# "anthropic" (default) or "openai". This is independent of which agent the
# audited sandbox runs -- it only selects the auditor's backend, reading
# either AUDITOR_ANTHROPIC_* or AUDITOR_OPENAI_* (see
# providers/session-auditor-*-profile.yaml).
#
# Set "openai" when the endpoint only accepts `Authorization: Bearer`, as an
# OpenShift MaaS / AI-Gateway endpoint does: session-auditor hardcodes
# `x-api-key` for its anthropic style and Bearer for its openai one
# (util/session-auditor/src/main.rs), so the anthropic style 401s there no
# matter what the provider profile says. "anthropic" is right for a vendor
# endpoint that accepts x-api-key, e.g. DeepSeek's /anthropic.
#
# Whichever you pick, the scene's `sandbox exec` must also pass
# AUDITOR_API_STYLE and the matching AUDITOR_<STYLE>_MODEL plus
# AUDITOR_LLM_BASE_URL -- only the API key arrives from the provider.
# Getting this wrong is silent: heartbeats still appear, only the
# compliance verdict is missing.
AUDITOR_PROVIDER_STYLE=anthropic

# Optional: audit-dashboard (see demos/keycloak-oidc/audit-dashboard/) —
# the live risk/heartbeat graph deployed in Scene 7.
AUDIT_DASHBOARD_ROUTE_HOST=          # optional override — e.g. audit-dashboard-<namespace>.<apps-domain>
