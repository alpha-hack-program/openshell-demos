# Demo-specific variables for saw-openclaw.
# Copy to .env alongside this file (gitignored). Real secrets never committed.
# Also source the root .env for cluster-wide variables (OPENSHELL_CHART_VERSION, etc.).

OPENSHELL_NAMESPACE=openshell-agents       # SAW deploys into this namespace
SAW_REPO=https://github.com/validatedpatterns-sandbox/secure-agent-workspace.git
SAW_DIR=                                   # local path after cloning SAW repo

# Cluster access — bare-metal OpenShift 4.22+ required (KubeVirt needs nested virtualization)
OCP_API=                                   # e.g. https://api.cluster-xxxx.dyn.redhatworkshops.io:6443
OCP_USER=admin
OCP_PASSWORD=

# SAW sandbox settings
SAW_SANDBOX_NAME=openclaw-test             # name for the SAW VM + sandbox
SAW_SANDBOX_OWNER=alice                    # Keycloak user that owns the sandbox
SAW_SSH_KEY_PATH=                          # path to generated SSH private key

# Inference provider — Google Gemini (direct API key, not Vertex AI)
GEMINI_API_KEY=                            # from https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.6-flash             # gemini-2.5-flash is deprecated as of Aug 2026
