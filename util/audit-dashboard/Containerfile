# syntax=docker/dockerfile:1
#
# audit-dashboard queries openshift-user-workload-monitoring's
# Thanos-querier from inside the cluster (via its own ServiceAccount
# token — no `openshell` CLI involved at all, unlike onboarding-web) and
# serves a small Preact graph of session-auditor metrics. See
# ../session-auditor/README.md and
# ../../demos/keycloak-oidc/docs/prometheus-scraping.md.
#
# Three stages: build the Preact frontend, build the Rust binary, then
# assemble the minimal runtime image from just those two outputs.
#
#   podman build -t audit-dashboard -f Containerfile .

ARG BASE_IMAGE=registry.access.redhat.com/ubi9/ubi-minimal
ARG BASE_TAG=9.6
# [VERIFY] pin an exact tag once confirmed against a real registry pull —
# left at `latest` for now rather than guessing a UBI Node.js tag scheme
# that hasn't been checked.
ARG NODE_BUILDER_IMAGE=registry.access.redhat.com/ubi9/nodejs-20-minimal:latest

FROM ${NODE_BUILDER_IMAGE} AS frontend-builder
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM registry.access.redhat.com/ubi9/ubi:${BASE_TAG} AS builder

RUN dnf update -y && \
    dnf install -y gcc gcc-c++ make pkg-config && \
    dnf clean all && \
    rm -rf /var/cache/dnf

ENV RUSTUP_HOME=/opt/rust
ENV CARGO_HOME=/opt/rust
ENV PATH=/opt/rust/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --no-modify-path

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY src/ ./src

RUN cargo build --release

FROM ${BASE_IMAGE}:${BASE_TAG}

LABEL org.opencontainers.image.title="audit-dashboard" \
      org.opencontainers.image.description="Live users -> sandbox -> MCP server risk/heartbeat graph, sourced from session-auditor metrics via Thanos-querier" \
      io.k8s.display-name="audit-dashboard" \
      io.openshift.tags="openshell,session-auditor,monitoring,rust"

RUN microdnf update -y && \
    microdnf install -y ca-certificates shadow-utils && \
    microdnf clean all && \
    rm -rf /var/cache/yum

RUN useradd -r -u 1001 -g 0 -s /sbin/nologin -c "audit-dashboard service user" auditdashboard

WORKDIR /app

COPY --from=builder /build/target/release/audit-dashboard /app/audit-dashboard
COPY --from=frontend-builder /build/dist /app/dist

RUN chown -R 1001:0 /app && \
    chmod -R g=u /app && \
    chmod +x /app/audit-dashboard

USER 1001

EXPOSE 8080

CMD ["/app/audit-dashboard"]
