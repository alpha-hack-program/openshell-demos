{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Parrot",
  "identifier": "com.openshell-demos.parrot",
  "build": {
    "frontendDist": "ui",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "python3 -m http.server 1430 --directory parrot-tauri/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "parrot",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns"]
  }
}
